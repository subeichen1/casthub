{
  "name": "casthub-server",
  "version": "0.1.0",
  "private": true,
  "description": "CastHub 局域网投屏中枢",
  "main": "desktop/main.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "e2e": "node scripts/e2e.mjs",
    "desktop": "electron desktop/main.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "chardet": "^2.1.0",
    "fast-xml-parser": "^4.5.7",
    "fastify": "^4.28.1",
    "iconv-lite": "^0.6.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "io.casthub.app",
    "productName": "CastHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "public/**/*",
      "scripts/fake-tv.mjs",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "CastHub.exe",
      "icon": "desktop/assets/icon.ico"
    }
  }
}

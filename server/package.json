{
  "name": "casthub-server",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "CastHub 局域网投屏中枢",
  "main": "desktop/main.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/tv-apps-meta.json','dist/tv-apps-meta.json')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src scripts desktop",
    "format": "biome format --write src scripts desktop public/app.js",
    "format:check": "biome format src scripts desktop public/app.js",
    "e2e": "node scripts/e2e.mjs",
    "e2e:all": "node scripts/e2e.mjs && node scripts/e2e-dlna.mjs && node scripts/e2e-history.mjs && node --import tsx scripts/e2e-subtitles.mjs && node --import tsx scripts/e2e-embedded-subtitles.mjs && node --import tsx scripts/e2e-security.mjs && node --import tsx scripts/e2e-queue.mjs && node scripts/e2e-tv-desktop.mjs && node --import tsx scripts/e2e-tv-release.mjs && node --import tsx scripts/e2e-tv-catalog.mjs && node --import tsx scripts/e2e-tv-network.mjs",
    "e2e-history": "node scripts/e2e-history.mjs",
    "e2e-subtitles": "node --import tsx scripts/e2e-subtitles.mjs",
    "e2e-embedded-subtitles": "node --import tsx scripts/e2e-embedded-subtitles.mjs",
    "e2e-security": "node --import tsx scripts/e2e-security.mjs",
    "e2e-queue": "node --import tsx scripts/e2e-queue.mjs",
    "e2e-tv-desktop": "node scripts/e2e-tv-desktop.mjs",
    "e2e-tv-release": "node --import tsx scripts/e2e-tv-release.mjs",
    "e2e-tv-catalog": "node --import tsx scripts/e2e-tv-catalog.mjs",
    "e2e-tv-network": "node --import tsx scripts/e2e-tv-network.mjs",
    "test:updater": "node --test scripts/updater.test.mjs",
    "perf": "node scripts/perf-smoke.mjs",
    "desktop": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "undici": "^8.13.1",
    "ws": "^8.23.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "build": {
    "appId": "io.casthub.app",
    "productName": "CastHub",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "CastHub.exe",
      "icon": "desktop/assets/icon.ico"
    }
  }
}
